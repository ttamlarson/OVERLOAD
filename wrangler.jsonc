{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "overload",
  "main": "workers/ai-coach/src/index.mjs",
  "compatibility_date": "2026-11-24",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/v1/coach*",
      "/v1/sync*"
    ]
  },
  "vars": {
    "AI_ENABLED": "true",
    "AI_API_BASE_URL": "https://api.openai.com/v1/chat/completions",
    "AI_MODEL": "gpt-4o-mini",
    "OVERLOAD_ALLOWED_ORIGIN": "https://ttamlarson.github.io"
  },
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "3104",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "d1_databases": [
    {
      "binding": "SYNC_DB",
      "database_name": "overload-encrypted-sync",
      "database_id": "d9fc263b-9ec0-4006-be57-031a314d4006",
      "migrations_dir": "migrations"
    }
  ]
}
